# ==============================================================================
# VisiOS Environment Variables & Deployment Configuration
# ==============================================================================

# Application Environment (development | staging | production)
NODE_ENV=production

# Server Port and Host Binding
PORT=3000
HOSTNAME=0.0.0.0

# Base Public URL
NEXT_PUBLIC_APP_URL=https://visios.app

# AI Authoring & Verification API Key (Optional for mock mode; required for live LLM providers)
# Keep server-side only - never expose with NEXT_PUBLIC_
AI_PROVIDER_API_KEY=your_secure_ai_api_key_here

# Collaboration & Realtime Configuration
COLLAB_SYNC_INTERVAL_MS=1200
MAX_UPLOAD_SIZE_MB=10

# Security & Session Secrets
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace_with_a_secure_32_byte_secret_in_production
